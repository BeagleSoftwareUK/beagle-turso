# Rust build output
/target
target/
**/target/

# Secrets — scratch Turso creds live here, never commit (given the leak saga)
.env
.env.*

# Throwaway spike local replica DB files
*.db
*.db-*

# Native extension build artifacts
*.so
*.o
**/Makefile

# SDD scratch (ledger, briefs, review packages)
.superpowers/

# extconf build log
mkmf.log
**/mkmf.log

# rake-compiler intermediate build dir + packaged gems (gems/*/lib/**/*.so already
# caught above; this covers the rest of the tmp/pkg scratch rake-compiler leaves behind)
gems/*/tmp/
gems/*/pkg/

# Gem lockfile — beagle-turso is a library gem, consumers resolve their own versions
gems/*/Gemfile.lock
