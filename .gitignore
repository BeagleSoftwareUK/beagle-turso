# Rust build output
/target
target/
**/target/

# Secrets — scratch Turso creds live here, never commit (given the leak saga)
.env
.env.*

# Throwaway spike local replica DB files
*.db
*.db-*

# Native extension build artifacts (.so on Linux, .bundle on macOS; the
# .bundle rule is anchored so it doesn't also hide Bundler's .bundle/ dirs)
*.so
gems/*/lib/**/*.bundle
*.o
**/Makefile

# SDD scratch (ledger, briefs, review packages)
.superpowers/

# extconf build log
mkmf.log
**/mkmf.log

# rake-compiler intermediate build dir + packaged gems (gems/*/lib/**/*.so already
# caught above; this covers the rest of the tmp/pkg scratch rake-compiler leaves behind)
gems/*/tmp/
gems/*/pkg/
# `gem build` output. The release workflow uploads gems/<name>/*.gem, so a
# committed one would be pushed along with the new version.
gems/*/*.gem

# Gem lockfile — beagle-turso is a library gem, consumers resolve their own versions
gems/*/Gemfile.lock
